rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL REUSABLE HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTimestamp(val) {
      return val is timestamp;
    }

    // Role Fetching Logic
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().roleId;
    }

    function getUserBranch() {
      return getUserData().branchId;
    }

    function isAdmin() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserRole() in ['super_admin', 'admin']
      );
    }

    function isBranchManager() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserRole() in ['manager', 'branch_manager', 'super_admin', 'admin']
      );
    }

    function isStaff() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserRole() in ['super_admin', 'admin', 'manager', 'branch_manager', 'manufacturing_staff', 'printing_staff', 'cashier', 'inventory_manager', 'staff'] ||
        getUserRole() != 'customer'
      );
    }

    // ==========================================
    // 2. ERP CORE COLLECTIONS
    // ==========================================

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, update: if isSignedIn() && (userId == request.auth.uid || isStaff());
      allow delete: if isAdmin();
    }

    // --- ROLES COLLECTION ---
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- CUSTOMERS COLLECTION ---
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- TEAMS COLLECTION ---
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- SUPPLIERS COLLECTION ---
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- INVENTORY COLLECTION ---
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() || isSignedIn();
      allow delete: if isAdmin();
    }

    // --- INVOICES COLLECTION ---
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- JOBS COLLECTION ---
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- MANUFACTURING JOBS ---
    match /manufacturing_jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- PRINTING JOBS ---
    match /printing_jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- REPAIR JOBS ---
    match /repair_jobs/{jobId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- ANALYTICS COLLECTION ---
    match /analytics/{analyticsId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- MANUFACTURING WORKFLOWS ---
    match /manufacturing_workflows/{workflowId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
