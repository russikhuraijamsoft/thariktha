rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return profileExists() && profile().status == 'active'
        && profile().roleId in ['OWNER','ADMIN','MANAGER','SALES','INVENTORY','PURCHASING','PRODUCTION','PRINTING','SERVICE','ACCOUNTING','VIEWER']
        && profile().companyId is string && profile().branchId is string;
    }
    function scoped() { return active() && resource.data.companyId == profile().companyId && resource.data.branchId == profile().branchId; }
    function manager() { return active() && profile().roleId in ['OWNER','ADMIN','MANAGER']; }
    // Server authenticates tokens and derives role/scope from users, then uses atomic
    // Admin SDK commands. Clients cannot bypass that boundary, including OWNER.
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || (manager() && scoped());
      allow list: if manager() && scoped();
      allow write: if false;
    }
    match /{entity}/{recordId} {
      allow read: if entity in ['products','customers','suppliers','quotations','orders',
        'deliveryorders','invoices','rfqs','purchaseorders','grns','purchasebills',
        'inventoryadjustments','stocktransfers','inventory','inventorytransactions',
        'manufacturing_jobs','printing_jobs','repair_jobs','expenses',
        'teams','analytics','manufacturing_workflows'] && scoped();
      allow read: if entity == 'transactions' && manager() && scoped();
      allow read: if entity in ['auditlogs','roles','settings'] && manager() && scoped();
      allow read: if entity == 'notifications' && scoped() &&
        (resource.data.recipientId == request.auth.uid || (resource.data.recipientId == 'all_branch_managers' && manager()));
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
