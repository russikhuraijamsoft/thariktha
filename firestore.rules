rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL REUSABLE HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTimestamp(val) {
      return val is timestamp;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().roleId;
    }

    function getUserBranch() {
      return getUserData().branchId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserRole() == 'super_admin' || getUserRole() == 'admin');
    }

    function isBranchManager() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserRole() == 'manager' || getUserRole() == 'branch_manager');
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserRole() in ['super_admin', 'admin', 'manager', 'branch_manager', 'manufacturing_staff', 'printing_staff', 'cashier', 'inventory_manager', 'staff']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // 2. COLLECTION RULES
    // ==========================================

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Users can read their own profile; staff can read all
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();

      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'name', 'email', 'roleId', 'branchId', 'status', 'createdAt', 'updatedAt'])
          && data.keys().size() == 8
          && data.uid == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.email is string && data.email.size() > 0 && data.email.size() <= 128
          && data.roleId is string && data.roleId.size() <= 50
          && data.branchId is string && data.branchId.size() <= 50
          && data.status in ['active', 'suspended', 'invited']
          && isTimestamp(data.createdAt)
          && isTimestamp(data.updatedAt);
      }

      // Self-registration: force customer role, no privilege escalation
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().roleId == 'customer';

      allow update: if isSignedIn()
        && (userId == request.auth.uid || isAdmin())
        && isValidUser(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && (
          // Self update: only name, email, updatedAt
          (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'updatedAt']))
          // Admin update: can modify role, status, branch
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // --- ROLES COLLECTION ---
    match /roles/{roleId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // --- CUSTOMERS COLLECTION ---
    match /customers/{customerId} {
      // Only staff can read customer PII
      allow get: if isStaff();
      allow list: if isStaff();

      function isValidCustomer(data) {
        return data.keys().hasAll(['id', 'name', 'email', 'branchId', 'createdAt', 'updatedAt'])
          && data.id is string
          && data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 128
          && data.branchId is string
          && isTimestamp(data.createdAt)
          && isTimestamp(data.updatedAt);
      }

      allow create: if isStaff()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isStaff()
        && isValidCustomer(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin();
    }

    // --- TEAMS COLLECTION ---
    match /teams/{teamId} {
      allow read: if isStaff();

      function isValidTeam(data) {
        return data.keys().hasAll(['id', 'name', 'sportType', 'customerId', 'branchId', 'createdAt', 'updatedAt'])
          && data.id is string
          && data.name is string && data.name.size() <= 100
          && data.sportType is string
          && data.customerId is string
          && data.branchId is string
          && isTimestamp(data.createdAt)
          && isTimestamp(data.updatedAt);
      }

      allow create: if isStaff()
        && isValidId(teamId)
        && isValidTeam(incoming())
        && exists(/databases/$(database)/documents/customers/$(incoming().customerId))
        && incoming().createdAt == request.time;

      allow update: if isStaff()
        && isValidTeam(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin();
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow read: if isSignedIn();

      function isValidProduct(data) {
        return data.keys().hasAll(['id', 'sku', 'name', 'category', 'unitPrice', 'costPrice', 'status', 'createdAt'])
          && data.id is string
          && data.sku is string && data.sku.size() <= 32
          && data.name is string && data.name.size() <= 150
          && data.category in ['bats', 'balls', 'protective', 'teamwear', 'accessories']
          && data.unitPrice is number && data.unitPrice >= 0
          && data.costPrice is number && data.costPrice >= 0
          && data.status in ['active', 'discontinued', 'draft']
          && isTimestamp(data.createdAt);
      }

      allow create: if isStaff()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == request.time;

      allow update: if isStaff()
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin();
    }

    // --- INVENTORY COLLECTION ---
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();

      function isValidInventory(data) {
        return data.keys().hasAll(['id', 'productId', 'branchId', 'quantityInStock', 'safetyStockLevel', 'reorderPoint', 'lastStockTakeAt'])
          && data.id is string
          && data.productId is string
          && data.branchId is string
          && data.quantityInStock is int
          && data.safetyStockLevel is int
          && data.reorderPoint is int
          && isTimestamp(data.lastStockTakeAt);
      }

      allow create: if isStaff()
        && isValidId(inventoryId)
        && isValidInventory(incoming())
        && exists(/databases/$(database)/documents/products/$(incoming().productId));

      allow update: if isStaff()
        && isValidInventory(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['quantityInStock', 'lastStockTakeAt'])
          || isAdmin() || isBranchManager()
        );

      allow delete: if isAdmin();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      // Staff can read all; customers can read their own
      allow get: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow list: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);

      function isValidOrder(data) {
        return data.keys().hasAll(['id', 'customerId', 'branchId', 'status', 'orderDate', 'paymentStatus', 'totalAmount', 'createdAt', 'updatedAt'])
          && data.id is string
          && data.customerId is string
          && data.branchId is string
          && data.status in ['draft', 'pending', 'manufacturing', 'printing', 'ready', 'delivered', 'canceled']
          && data.paymentStatus in ['unpaid', 'partially_paid', 'paid']
          && data.totalAmount is number && data.totalAmount >= 0
          && isTimestamp(data.orderDate)
          && isTimestamp(data.createdAt)
          && isTimestamp(data.updatedAt);
      }

      allow create: if isSignedIn()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().customerId == request.auth.uid || isStaff());

      allow update: if isSignedIn()
        && isValidOrder(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && (
          // Clients can cancel their own pending/draft orders
          (incoming().customerId == request.auth.uid && existing().status in ['draft', 'pending'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'canceled')
          // Staff can update
          || isStaff()
        );

      allow delete: if isAdmin();
    }

    // --- INVOICES COLLECTION ---
    match /invoices/{invoiceId} {
      // Only staff can read invoices
      allow get: if isStaff();
      allow list: if isStaff();

      function isValidInvoice(data) {
        return data.keys().hasAll(['id', 'orderId', 'invoiceNumber', 'amountDue', 'amountPaid', 'dueDate', 'status', 'createdAt'])
          && data.id is string
          && data.orderId is string
          && data.invoiceNumber is string
          && data.amountDue is number && data.amountDue >= 0
          && data.amountPaid is number && data.amountPaid >= 0
          && data.dueDate is string
          && data.status in ['unpaid', 'partially_paid', 'paid', 'voided']
          && isTimestamp(data.createdAt);
      }

      allow create: if isStaff()
        && isValidId(invoiceId)
        && isValidInvoice(incoming())
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && incoming().createdAt == request.time;

      allow update: if isStaff()
        && isValidInvoice(incoming())
        && incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin();
    }

    // --- TRANSACTIONS COLLECTION ---
    match /transactions/{transactionId} {
      // Only staff can read financial transactions
      allow read: if isStaff();

      function isValidTransaction(data) {
        return data.keys().hasAll(['id', 'branchId', 'paymentMethod', 'amount', 'type', 'status', 'date'])
          && data.id is string
          && data.branchId is string
          && data.paymentMethod in ['cash', 'card', 'bank_transfer', 'cheque']
          && data.amount is number && data.amount > 0
          && data.type in ['credit', 'debit']
          && data.status in ['pending', 'cleared', 'failed']
          && isTimestamp(data.date);
      }

      allow create: if isStaff()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().date == request.time;

      allow update: if isStaff()
        && isValidTransaction(incoming())
        && incoming().date == existing().date;

      allow delete: if isAdmin();
    }

    // --- MANUFACTURING JOBS ---
    match /manufacturing_jobs/{jobId} {
      allow read: if isSignedIn();

      function isValidMJob(data) {
        return data.keys().hasAll(['id', 'orderId', 'status', 'priority', 'startDate'])
          && data.id is string
          && data.orderId is string
          && data.status in ['queued', 'wood-splicing', 'shaping', 'pressing', 'binding', 'finishing', 'quality-check', 'complete']
          && data.priority in ['low', 'medium', 'high', 'rush']
          && isTimestamp(data.startDate);
      }

      allow create: if isStaff()
        && isValidId(jobId)
        && isValidMJob(incoming())
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId));

      allow update: if isStaff()
        && isValidMJob(incoming())
        && (
          (getUserRole() == 'craftsman' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'qualityScore']))
          || isBranchManager() || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // --- PRINTING JOBS ---
    match /printing_jobs/{jobId} {
      allow read: if isSignedIn();

      function isValidPJob(data) {
        return data.keys().hasAll(['id', 'orderId', 'printingType', 'status', 'itemsCount'])
          && data.id is string
          && data.orderId is string
          && data.printingType in ['sublimation', 'embroidery', 'screen-print', 'vinyl-transfer']
          && data.status in ['queued', 'vector-proofing', 'print-run', 'curing', 'quality-check', 'complete']
          && data.itemsCount is int && data.itemsCount >= 0;
      }

      allow create: if isStaff()
        && isValidId(jobId)
        && isValidPJob(incoming())
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId));

      allow update: if isStaff()
        && isValidPJob(incoming())
        && (
          (getUserRole() == 'printer' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedDate']))
          || isBranchManager() || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // --- REPAIR JOBS ---
    match /repair_jobs/{jobId} {
      allow read: if isSignedIn();

      function isValidRJob(data) {
        return data.keys().hasAll(['id', 'customerId', 'itemDescription', 'repairType', 'status', 'priceQuote'])
          && data.id is string
          && data.customerId is string
          && data.itemDescription is string && data.itemDescription.size() > 0
          && data.repairType in ['scuff-clearing', 'thread-wrap', 'toe-guard', 'handle-re-splice', 'blade-bind']
          && data.status in ['received', 'assessing', 'in-repair', 'polishing', 'ready']
          && data.priceQuote is number && data.priceQuote >= 0;
      }

      allow create: if isStaff()
        && isValidId(jobId)
        && isValidRJob(incoming());

      allow update: if isStaff()
        && isValidRJob(incoming());

      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notifId} {
      // Users can read their own notifications; staff can read all
      allow get: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isStaff());
      // List queries must filter by recipientId or branchId
      allow list: if isSignedIn();

      function isValidNotification(data) {
        return data.keys().hasAll(['id', 'recipientId', 'category', 'title', 'message', 'read', 'branchId', 'createdAt'])
          && data.id is string
          && data.recipientId is string
          && data.category in ['inventory_alert', 'job_advancement', 'new_order', 'payment_overdue']
          && data.title is string && data.title.size() <= 128
          && data.message is string && data.message.size() <= 400
          && data.read is bool
          && data.branchId is string
          && isTimestamp(data.createdAt);
      }

      allow create: if isStaff()
        && isValidId(notifId)
        && isValidNotification(incoming())
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && isValidNotification(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (resource.data.recipientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
          || isStaff()
        );

      allow delete: if isStaff();
    }

    // --- ANALYTICS COLLECTION ---
    match /analytics/{analyticsId} {
      allow get: if isBranchManager() || isAdmin();
      allow list: if isBranchManager() || isAdmin();

      function isValidAnalytics(data) {
        return data.keys().hasAll(['id', 'branchId', 'date', 'totalSales', 'activeJobsCount', 'completedJobsCount', 'leadTimeMs', 'updatedAt'])
          && data.id is string
          && data.branchId is string
          && data.date is string
          && data.totalSales is number && data.totalSales >= 0
          && data.activeJobsCount is int && data.activeJobsCount >= 0
          && data.completedJobsCount is int && data.completedJobsCount >= 0
          && data.leadTimeMs is number && data.leadTimeMs >= 0
          && isTimestamp(data.updatedAt);
      }

      allow create, update: if isAdmin()
        && isValidId(analyticsId)
        && isValidAnalytics(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- MANUFACTURING WORKFLOWS ---
    match /manufacturing_workflows/{workflowId} {
      allow read: if isSignedIn();

      function isValidWorkflow(data) {
        return data.keys().hasAll(['id', 'orderId', 'customerName', 'quantity', 'dueDate', 'stage', 'createdAt', 'updatedAt'])
          && data.id is string
          && data.orderId is string
          && data.customerName is string && data.customerName.size() <= 100
          && data.quantity is int && data.quantity > 0
          && data.dueDate is string
          && data.stage in ["Pending", "Design Approved", "Cutting", "Printing", "Stitching", "Quality Check", "Packed", "Ready for Delivery", "Delivered"]
          && isTimestamp(data.createdAt)
          && isTimestamp(data.updatedAt);
      }

      allow create: if isStaff()
        && isValidId(workflowId)
        && isValidWorkflow(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isStaff()
        && isValidWorkflow(incoming())
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin();
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingId} {
      // Only admins can read/write settings
      allow get: if isAdmin();
      allow list: if isAdmin();

      function isValidSetting(data) {
        return data.keys().hasAll(['id', 'updatedBy', 'updatedAt', 'configMap'])
          && data.keys().size() == 4
          && data.id is string
          && data.updatedBy == request.auth.uid
          && isTimestamp(data.updatedAt)
          && data.configMap is map;
      }

      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidSetting(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidSetting(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }
  }
}
