rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Global Zero-Trust Safety Net: Deny Everything by Default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ==========================================
    // REUSABLE HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Native Cloud Cross-Service call to retrieve standard user profiles in Firestore
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().roleId;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return isSignedIn() && getUserRole() in [
        'super_admin', 'admin', 'manager', 'branch_manager',
        'manufacturing_staff', 'printing_staff', 'cashier',
        'inventory_manager', 'staff'
      ];
    }

    // Enforce payload metadata size limits to block Denial of Wallet storage exhaustion
    function isWithinSizeLimit(maxMegabytes) {
      return request.resource.size < maxMegabytes * 1024 * 1024;
    }

    // Secure Mime-Type validators
    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidDesignAsset() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/postscript'
        || request.resource.contentType == 'image/svg+xml'
        || request.resource.contentType == 'application/pdf';
    }

    function isValidInvoicePDF() {
      return request.resource.contentType == 'application/pdf';
    }

    // ==========================================
    // STRUCTURED ACCESS PATHS
    // ==========================================

    // 1. User profile avatars (Ownership isolation)
    match /users/{userId}/avatars/{fileId} {
      // Only the owner can read/write their own avatar
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && isWithinSizeLimit(5) // Max 5MB profile photos
        && isValidImage();
    }

    // 2. Apparel vector models & custom sublimation fabric design assets
    match /printing_designs/{jobId}/{fileId} {
      // Only staff can read/write design assets
      allow read: if isStaff();
      allow write: if isStaff()
        && isWithinSizeLimit(25) // Up to 25MB for high density print PDFs / vectors
        && isValidDesignAsset();
    }

    // 3. Wood grain specs & bat manufacturing specifications
    match /manufacturing_blueprints/{jobId}/{fileId} {
      // Only staff can read/write manufacturing blueprints
      allow read: if isStaff();
      allow write: if isStaff()
        && isWithinSizeLimit(15) // Max 15MB specs
        && isValidDesignAsset();
    }

    // 4. Invoices templates & financial transaction receipts (PDF only)
    match /invoices/{invoiceId}/{fileId} {
      // Only staff can read/write invoice files
      allow read: if isStaff();
      allow write: if isStaff()
        && isWithinSizeLimit(10) // Max 10MB invoice files
        && isValidInvoicePDF();
    }
  }
}
