/**
 * Firestore Security Rules for Procurement Module
 * Add these rules to your main firestore.rules file
 */

// ============================================================
// SUPPLIERS COLLECTION RULES
// ============================================================
match /suppliers/{supplierId} {
  // Read: Users can read suppliers in their branch
  allow read: if request.auth != null && 
              request.auth.token.branch == resource.data.branchId;
  
  // Create: Only staff and branch managers can create suppliers
  allow create: if request.auth != null &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                request.resource.data.branchId == request.auth.token.branch &&
                request.resource.data.status in ['Active', 'Inactive'] &&
                request.resource.data.keys().hasAll(['supplierCode', 'name', 'email', 'phone']);
  
  // Update: Only branch managers can update suppliers
  allow update: if request.auth != null &&
                request.auth.token.role == 'branch_manager' &&
                resource.data.branchId == request.auth.token.branch &&
                request.resource.data.branchId == resource.data.branchId;
  
  // Delete: Only admins can delete suppliers
  allow delete: if request.auth != null &&
                request.auth.token.role == 'admin';
}

// ============================================================
// PURCHASE ORDERS COLLECTION RULES
// ============================================================
match /purchase_orders/{poId} {
  // Read: Users can read POs in their branch
  allow read: if request.auth != null && 
              request.auth.token.branch == resource.data.branchId;
  
  // Create: Only procurement staff and branch managers can create POs
  allow create: if request.auth != null &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                request.resource.data.branchId == request.auth.token.branch &&
                request.resource.data.status == 'draft' &&
                request.resource.data.items.size() > 0 &&
                request.resource.data.keys().hasAll(['poNumber', 'supplierId', 'orderDate', 'items']);
  
  // Update: Staff and branch managers can update draft and submitted POs
  allow update: if request.auth != null &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                resource.data.branchId == request.auth.token.branch &&
                (resource.data.status == 'draft' || 
                 resource.data.status == 'submitted' || 
                 resource.data.status == 'confirmed') &&
                request.resource.data.branchId == resource.data.branchId;
  
  // Update status transitions (more restrictive)
  allow update: if request.auth != null &&
                resource.data.branchId == request.auth.token.branch &&
                request.resource.data.status in ['draft', 'submitted', 'confirmed', 'partial_received', 'received', 'cancelled'] &&
                ((resource.data.status == 'draft' && request.resource.data.status == 'submitted') ||
                 (resource.data.status == 'submitted' && request.resource.data.status == 'confirmed') ||
                 (resource.data.status == 'confirmed' && request.resource.data.status in ['partial_received', 'received', 'cancelled']) ||
                 (resource.data.status == 'partial_received' && request.resource.data.status in ['received', 'cancelled']));
  
  // Delete: Only draft POs can be deleted
  allow delete: if request.auth != null &&
                resource.data.branchId == request.auth.token.branch &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                resource.data.status == 'draft';
}

// ============================================================
// GOODS RECEIPTS COLLECTION RULES
// ============================================================
match /goods_receipts/{grId} {
  // Read: Users can read GRs in their branch
  allow read: if request.auth != null && 
              request.auth.token.branch == resource.data.branchId;
  
  // Create: Only receiving staff and branch managers can create GRs
  allow create: if request.auth != null &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                request.resource.data.branchId == request.auth.token.branch &&
                request.resource.data.status == 'draft' &&
                request.resource.data.items.size() > 0 &&
                request.resource.data.keys().hasAll(['grNumber', 'purchaseOrderId', 'items', 'receiptDate']);
  
  // Update: Staff and branch managers can update GRs
  allow update: if request.auth != null &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                resource.data.branchId == request.auth.token.branch &&
                request.resource.data.branchId == resource.data.branchId;
  
  // Status transitions validation
  allow update: if request.auth != null &&
                resource.data.branchId == request.auth.token.branch &&
                request.resource.data.status in ['draft', 'received', 'inspected', 'accepted', 'rejected'] &&
                ((resource.data.status == 'draft' && request.resource.data.status == 'received') ||
                 (resource.data.status == 'received' && request.resource.data.status == 'inspected') ||
                 (resource.data.status == 'inspected' && request.resource.data.status in ['accepted', 'rejected']));
  
  // Delete: Only draft GRs can be deleted
  allow delete: if request.auth != null &&
                resource.data.branchId == request.auth.token.branch &&
                (request.auth.token.role == 'staff' || 
                 request.auth.token.role == 'branch_manager') &&
                resource.data.status == 'draft';
}

// ============================================================
// INVENTORY MOVEMENTS COLLECTION RULES (Append-Only Audit Trail)
// ============================================================
match /inventory_movements/{movementId} {
  // Read: Users can read movements in their branch
  allow read: if request.auth != null && 
              request.auth.token.branch == resource.data.branchId;
  
  // Create: Only during GR acceptance and inventory adjustments
  allow create: if request.auth != null &&
                request.resource.data.branchId == request.auth.token.branch &&
                request.resource.data.movementType in ['PURCHASE_RECEIPT', 'ADJUSTMENT', 'DAMAGE_WRITE_OFF', 'REORDER'] &&
                request.resource.data.keys().hasAll(['productSku', 'movementType', 'quantity', 'operator']);
  
  // Update: NOT allowed (append-only audit trail)
  allow update: false;
  
  // Delete: NOT allowed (permanent audit trail)
  allow delete: false;
}

// ============================================================
// INTEGRATION WITH PRODUCTS COLLECTION
// ============================================================
// When GR is accepted, update product inventory
match /products/{productId} {
  // Update inventory on GR acceptance
  allow update: if request.auth != null &&
                request.auth.token.role in ['staff', 'branch_manager', 'admin'] &&
                request.resource.data.currentStock >= 0; // Ensure non-negative stock
}
