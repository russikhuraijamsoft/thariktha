# Deny by default: include only files needed for this Docker build.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!tsconfig.json
!vite.config.ts
!firebase-applet-config.json
!server.ts
!src/
!src/**
!shared/
!shared/**
!server/
!server/**
!public/
!public/**
!scripts/
!scripts/verify-build.mjs
# Re-exclude credentials even inside allowed source/public directories.
**/.env
**/.env.*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/*service-account*
**/*service_account*
**/*credentials*
**/*credential*.json
**/*secret*.json
**/*private-key*
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/application_default_credentials.json
**/*.log
