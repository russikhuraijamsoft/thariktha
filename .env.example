# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==========================================
# FIREBASE ADMIN SDK (Server-side auth)
# ==========================================
# Application Default Credentials (ADC) are used by the server.
# On a managed host prefer workload identity / an attached service account.
# For local development, provide ADC outside this repository, for example:
# GOOGLE_APPLICATION_CREDENTIALS="/private/path/service-account.json"
# Inline FIREBASE_SERVICE_ACCOUNT_KEY is not supported. Never commit credentials.
# GOOGLE_CLOUD_PROJECT and FIRESTORE_DATABASE_ID default to firebase-applet-config.json.
# Match the client project and the database containing provisioned users/{uid}.
# GOOGLE_CLOUD_PROJECT="your-firebase-project"
# FIRESTORE_DATABASE_ID="(default)"
# /api/health is public. Protected endpoints require a bearer ID token and an
# active server-side employee profile. Missing tokens return 401; verification
# or persistence dependencies that are unavailable return 503.
# Production business writes stay disabled until schema/data review is approved.
# ERP_SCHEMA_APPROVED=false

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# PORT=3000
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# DISABLE_HMR=true
