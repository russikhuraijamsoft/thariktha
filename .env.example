# Firebase web config already exists in firebase-applet-config.json.
# Its apiKey identifies the Firebase client; it is NOT a server credential.
# Server: use workload identity / Application Default Credentials. Never VITE_ prefix secrets.
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/service-account.json
GOOGLE_CLOUD_PROJECT=cricket-closet-imphal
FIRESTORE_DATABASE_ID=ai-studio-cricketcloseterp-2be2e18e-4031-4d60-99a3-500634b8d6be
# Remain false until live collection/schema/scope review and reconciliation.
ERP_SCHEMA_APPROVED=false
PORT=3000
HOST=127.0.0.1
# Comma-separated trusted browser/native webview origins for hosted API.
ALLOWED_ORIGINS=
# Public HTTPS API origin, required for native/static hosted clients (no credentials).
VITE_API_BASE_URL=
