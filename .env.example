# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==========================================
# FIREBASE ADMIN SDK (Server-side auth)
# ==========================================
# Option 1: Path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
#
# Option 2: Inline service account key (JSON string)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
#
# The server uses this to verify Firebase ID tokens on API requests.
# Without this, all /api/* endpoints will return 503 SERVICE_UNAVAILABLE.

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# PORT=3000
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# DISABLE_HMR=true
