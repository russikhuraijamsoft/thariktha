{
  "name": "cricket-closet-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:web && npm run build:server && node scripts/verify-build.mjs",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "start": "node scripts/start-server.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node scripts/run-tests.mjs unit",
    "test:erp": "node scripts/run-emulator-tests.mjs",
    "test:erp:local": "node scripts/run-tests.mjs emulator",
    "test:server": "firebase emulators:exec --only firestore --project demo-thariktha --config firebase.json \"node scripts/server-smoke.mjs\"",
    "emulator:start": "firebase emulators:start --only firestore --project demo-thariktha --config firebase.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/vite": "4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.32.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "lightningcss": "npm:lightningcss-wasm@1.30.1"
  }
}
